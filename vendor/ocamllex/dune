(library
 (name ocamllexSyntax)
 (libraries menhir_lsp_lib)
 (preprocess
  (pps visitors.ppx)))

(copy_files ../common/*.ml)

(env
 (dev
  (flags :standard -warn-error -7-17 -w -27-32)))

(ocamllex lexer)

(menhir
 (modules parser))

(menhir
 (modules original_parser)
 (flags --cmly --exn-carries-state --require-aliases --external-tokens Parser))

(rule
 (deps original_parser.messages)
 (targets original_parser_messages.ml)
 (action
  (with-stdout-to
   original_parser_messages.ml
   (run menhir original_parser.mly --compile-errors original_parser.messages))))
