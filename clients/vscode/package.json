{
  "name": "menhir-lsp-client",
  "displayName": "Menhir",
  "description": "IntelliSense for Menhir grammars and Ocamllex lexers",
  "version": "3.2.2",
  "publisher": "dalps",
  "private": true,
  "license": "GPL-2.0-only",
  "icon": "icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dalps/menhir-lsp"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:ocaml.menhir",
    "onLanguage:ocaml.ocamllex"
  ],
  "contributes": {
    "grammars": [
      {
        "language": "ocaml.menhir.messages",
        "scopeName": "source.ocaml.menhir.messages",
        "path": "./syntaxes/ocaml.menhir.messages.json"
      }
    ],
    "colors": [
      {
        "id": "menhirlsp.astExplorer.highlightColor",
        "defaults": {
          "light": "#0000ff33",
          "dark": "#9393ff66"
        },
        "description": "The background color of the source code contained in the highlighted AST node."
      }
    ],
    "languages": [
      {
        "id": "ocaml.menhir",
        "icon": {
          "dark": "icons/menhir.svg",
          "light": "icons/menhir.svg"
        }
      },
      {
        "id": "ocaml.ocamllex",
        "icon": {
          "dark": "icons/ocamllex.svg",
          "light": "icons/ocamllex.svg"
        }
      },
      {
        "id": "ocaml.menhir.messages",
        "extensions": [
          ".messages"
        ],
        "icon": {
          "dark": "icons/menhir.svg",
          "light": "icons/menhir.svg"
        },
        "configuration": "languages/ocaml.menhir.messages.language-configuration.json"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "menhir-lsp-client.refreshEntrypoints",
          "when": "view == menhir-lsp-workspace-parsers || view == menhir-lsp-workspace-lexers",
          "group": "navigation"
        },
      ],
      "view/item/context": [
        {
          "command": "menhir-lsp-client.editRegexpTokenBinding",
          "when": "view == menhir-lsp-action-map && viewItem == regexpKey",
          "group": "inline"
        },
        {
          "command": "menhir-lsp-client.startTokenizer",
          "when": "view == menhir-lsp-workspace-lexers && viewItem == entrypoint",
          "group": "inline"
        },
        {
          "command": "menhir-lsp-client.runParser",
          "when": "view == menhir-lsp-workspace-parsers && viewItem == entrypoint",
          "group": "inline"
        },
        {
          "command": "menhir-lsp-client.connectParserWithLexer",
          "when": "view == menhir-lsp-workspace-parsers && viewItem == entrypoint",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "when": "editorTextFocus && (editorLangId == ocaml.menhir || editorLangId == ocaml.ocamllex)",
          "command": "menhir-lsp-client.gotoImplementation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "menhir-lsp-client.nextMessage",
        "when": "editorTextFocus && editorLangId == ocaml.menhir.messages",
        "key": "alt+n"
      },
      {
        "command": "menhir-lsp-client.nextDummyMessage",
        "when": "editorTextFocus && editorLangId == ocaml.menhir.messages",
        "key": "alt+shift+n"
      },
      {
        "command": "menhir-lsp-client.previousMessage",
        "when": "editorTextFocus && editorLangId == ocaml.menhir.messages",
        "key": "alt+p"
      },
      {
        "command": "menhir-lsp-client.previousDummyMessage",
        "when": "editorTextFocus && editorLangId == ocaml.menhir.messages",
        "key": "alt+shift+p"
      }
    ],
    "views": {
      "menhir-lsp-view-container": [
        {
          "id": "menhir-lsp-workspace-lexers",
          "name": "Workspace Lexers",
          "icon": "icons/icon_outline_thick.svg",
          "contextualTitle": "Workspace Lexers"
        },
        {
          "id": "menhir-lsp-workspace-parsers",
          "name": "Workspace Parsers",
          "icon": "icons/icon_outline_thick.svg",
          "contextualTitle": "Workspace Parsers"
        },
        {
          "id": "menhir-lsp-derivation-view",
          "name": "Derivation Explorer",
          "icon": "icons/icon_outline_thick.svg",
          "contextualTitle": "Derivation Explorer"
        },
        {
          "id": "menhir-lsp-action-map",
          "name": "Action-Token Mapping",
          "icon": "icons/icon_outline_thick.svg",
          "contextualTitle": "Action-Token Mapping"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "menhir-lsp-workspace-lexers",
        "contents": "The lexers available in the workspace will appear here, ready for debugging."
      },
      {
        "view": "menhir-lsp-workspace-parsers",
        "contents": "The parsers available in the workspace which have been compiled to the [CMLY format](https://cambium.inria.fr/~fpottier/menhir/manual.html#sec110) will appear here, ready for debugging.\n\nTo ask dune to generate the CMLY representation of a parser, open the dune file next its .mly file and add the `--cmly` flag inside the Menhir stanza.\n\n[Menhir stanza docs](https://dune.readthedocs.io/en/stable/reference/dune/menhir.html)"
      },
      {
        "view": "menhir-lsp-action-map",
        "contents": "This view lets you associate a lexer's actions to a parser's tokens. It will be filled in after you click the \"Plug lexer\" button on a parser in the Workspace Parsers view and have selected a lexer that will produce tokens for it.\nThe initial map is inferred automatically and may be inaccurate, therefore it is your responsibility to make sure the actions have the correct semantics.\n\nThere are three kinds of behaviors you can set as the regexp's action:\n- **Produce** a token of the selected parser\n- **Skip** and read the next token\n- **Fail** (halt the lexer.)\nOnce the map suitably models the actual behavior of the OCaml code in your lexer rule, you can start interpreting sentences by pressing the \"Play\" button at the top of the view."
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "menhir-lsp-view-container",
          "title": "Menhir LSP",
          "icon": "icons/icon_outline_thick.svg",
          "contextualTitle": "Menhir LSP"
        }
      ]
    },
    "commands": [
      {
        "title": "Menhir: Start Interactive Parser",
        "command": "menhir-lsp-client.startParser"
      },
      {
        "title": "Menhir: Connect Parser With Lexer",
        "command": "menhir-lsp-client.connectParserWithLexer",
        "icon": "$(debug-connected)"
      },
      {
        "title": "Menhir: Start Interactive Tokenizer",
        "command": "menhir-lsp-client.startTokenizer",
        "icon": "$(play)"
      },
      {
        "title": "Menhir: Go To Implementation",
        "shortTitle": "Go To Implementation",
        "command": "menhir-lsp-client.gotoImplementation"
      },
      {
        "title": "Menhir: Show Language Server Output",
        "command": "menhir-lsp-client.showOutput"
      },
      {
        "title": "Menhir: Restart Language Server",
        "command": "menhir-lsp-client.restartServer"
      },
      {
        "title": "Menhir: Show AST View",
        "command": "menhir-lsp-client.astView"
      },
      {
        "title": "Menhir: Reveal AST Lode Under Cursor",
        "enablement": "never",
        "command": "menhir-lsp-client.revealAstNode"
      },
      {
        "title": "Menhir: Focus Next Message",
        "command": "menhir-lsp-client.nextMessage",
        "enablement": "editorLangId == ocaml.menhir.messages"
      },
      {
        "title": "Menhir: Focus Next Dummy Message",
        "command": "menhir-lsp-client.nextDummyMessage",
        "enablement": "editorLangId == ocaml.menhir.messages"
      },
      {
        "title": "Menhir: Focus Previous Message",
        "command": "menhir-lsp-client.previousMessage",
        "enablement": "editorLangId == ocaml.menhir.messages"
      },
      {
        "title": "Menhir: Focus Previous Dummy Message",
        "command": "menhir-lsp-client.previousDummyMessage",
        "enablement": "editorLangId == ocaml.menhir.messages"
      },
      {
        "title": "Menhir: prompt for an alias",
        "enablement": "never",
        "command": "menhir-lsp-client.promptAlias"
      },
      {
        "title": "echo errors",
        "enablement": "never",
        "command": "menhir-lsp-client.echoErrors"
      },
      {
        "title": "Menhir: Edit Regexp-Token Binding",
        "shortTitle": "Edit Binding",
        "command": "menhir-lsp-client.editRegexpTokenBinding",
        "icon": "$(edit)"
      },
      {
        "title": "Menhir: Refresh Entrypoints",
        "command": "menhir-lsp-client.refreshEntrypoints",
        "icon": "$(refresh)"
      },
      {
        "title": "Menhir: Run Parser",
        "command": "menhir-lsp-client.runParser",
        "icon": "$(play)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Menhir LSP - Formatting options",
      "properties": {
        "menhir.format.maxWidth": {
          "type": "integer",
          "default": 80,
          "description": "Maximum number of characters per line."
        },
        "menhir.format.indentOnce": {
          "type": "boolean",
          "default": false,
          "description": "Add a level of indentation to the cases of a rule or (default) keep them flush with the start of the definition."
        },
        "menhir.format.noLeadingBar": {
          "type": "boolean",
          "default": false,
          "description": "Omit the optional leading bar `|` in the first case of a rule."
        },
        "menhir.format.semiAfterProducer": {
          "type": "boolean",
          "default": false,
          "description": "Terminate every producer with a semicolon in Menhir rules written in the traditional syntax."
        }
      }
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "just bundle",
    "build": "just bundle",
    "debug": "just build",
    "watch": "just watch"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.73.0",
    "@types/vscode-webview": "^1.57.5",
    "esbuild": "^0.28.0",
    "esbuild-svelte": "^0.9.4",
    "mocha": "^11.7.5",
    "svelte": "^5.55.1",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}