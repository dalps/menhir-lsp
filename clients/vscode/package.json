{
  "name": "menhir-lsp-client",
  "displayName": "Menhir",
  "description": "IntelliSense for Menhir grammars and Ocamllex lexers",
  "version": "3.2.2",
  "publisher": "dalps",
  "private": true,
  "license": "GPL-2.0-only",
  "icon": "icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dalps/menhir-lsp"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:ocaml.menhir",
    "onLanguage:ocaml.ocamllex"
  ],
  "contributes": {
    "grammars": [
      {
        "language": "ocaml.menhir.messages",
        "scopeName": "source.ocaml.menhir.messages",
        "path": "./syntaxes/ocaml.menhir.messages.json"
      }
    ],
    "colors": [
      {
        "id": "menhirlsp.astExplorer.highlightColor",
        "defaults": {
          "light": "#0000ff33",
          "dark": "#9393ff66"
        },
        "description": "The background color of the source code contained in the highlighted AST node."
      }
    ],
    "icons": {
      "play-to-start": {
        "description": "Play/Run to start",
        "default": {
          "fontPath": "icons/myiconfont.ttf",
          "fontCharacter": "\\c350"
        }
      },
      "play-to-end": {
        "description": "Play/Run to end",
        "default": {
          "fontPath": "icons/myiconfont.ttf",
          "fontCharacter": "\\c351"
        }
      }
    },
    "languages": [
      {
        "id": "ocaml.menhir",
        "icon": {
          "dark": "icons/menhir.svg",
          "light": "icons/menhir.svg"
        }
      },
      {
        "id": "ocaml.ocamllex",
        "icon": {
          "dark": "icons/ocamllex.svg",
          "light": "icons/ocamllex.svg"
        }
      },
      {
        "id": "ocaml.menhir.messages",
        "extensions": [
          ".messages"
        ],
        "icon": {
          "dark": "icons/menhir.svg",
          "light": "icons/menhir.svg"
        },
        "configuration": "languages/ocaml.menhir.messages.language-configuration.json"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "menhir-lsp-client.refreshEntrypoints",
          "when": "view == menhir-lsp-entrypoint-explorer",
          "group": "navigation"
        },
        {
          "command": "menhir-lsp-client.stopInterpreter",
          "when": "view == menhir-lsp-derivation-view",
          "group": "navigation@4"
        },
        {
          "command": "menhir-lsp-client.playForward",
          "alt": "menhir-lsp-client.playToEnd",
          "when": "view == menhir-lsp-derivation-view",
          "group": "navigation@3"
        },
        {
          "command": "menhir-lsp-client.stepForward",
          "when": "view == menhir-lsp-derivation-view",
          "group": "navigation@2"
        },
        {
          "command": "menhir-lsp-client.stepBackward",
          "when": "view == menhir-lsp-derivation-view",
          "group": "navigation@1"
        },
        {
          "command": "menhir-lsp-client.playBackward",
          "alt": "menhir-lsp-client.playToStart",
          "when": "view == menhir-lsp-derivation-view",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "menhir-lsp-client.editRegexpTokenBinding",
          "when": "view == menhir-lsp-action-map && viewItem == regexpKey",
          "group": "inline"
        },
        {
          "command": "menhir-lsp-client.startTokenizer",
          "when": "view == menhir-lsp-entrypoint-explorer && viewItem == lexerEntrypoint",
          "group": "inline"
        },
        {
          "command": "menhir-lsp-client.startParserWithCheckpoints",
          "alt": "menhir-lsp-client.startParser",
          "when": "view == menhir-lsp-entrypoint-explorer && viewItem == parserEntrypoint",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "when": "editorTextFocus && (editorLangId == ocaml.menhir || editorLangId == ocaml.ocamllex)",
          "command": "menhir-lsp-client.gotoImplementation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "menhir-lsp-client.nextMessage",
        "when": "editorTextFocus && editorLangId == ocaml.menhir.messages",
        "key": "alt+n"
      },
      {
        "command": "menhir-lsp-client.nextDummyMessage",
        "when": "editorTextFocus && editorLangId == ocaml.menhir.messages",
        "key": "alt+shift+n"
      },
      {
        "command": "menhir-lsp-client.previousMessage",
        "when": "editorTextFocus && editorLangId == ocaml.menhir.messages",
        "key": "alt+p"
      },
      {
        "command": "menhir-lsp-client.previousDummyMessage",
        "when": "editorTextFocus && editorLangId == ocaml.menhir.messages",
        "key": "alt+shift+p"
      },
      {
        "command": "menhir-lsp-client.stepForward",
        "when": "menhir-lsp-client.interpreterRunning == true",
        "key": "alt+n"
      },
      {
        "command": "menhir-lsp-client.stepBackward",
        "when": "menhir-lsp-client.interpreterRunning == true",
        "key": "alt+p"
      },
      {
        "command": "menhir-lsp-client.playForward",
        "when": "menhir-lsp-client.interpreterRunning == true",
        "key": "alt+f"
      },
      {
        "command": "menhir-lsp-client.playBackward",
        "when": "menhir-lsp-client.interpreterRunning == true",
        "key": "alt+b"
      },
      {
        "command": "menhir-lsp-client.playToEnd",
        "when": "menhir-lsp-client.interpreterRunning == true",
        "key": "alt+shift+f"
      },
      {
        "command": "menhir-lsp-client.playToStart",
        "when": "menhir-lsp-client.interpreterRunning == true",
        "key": "alt+shift+b"
      }
    ],
    "views": {
      "menhir-lsp-view-container": [
        {
          "id": "menhir-lsp-entrypoint-explorer",
          "name": "Entrypoint Explorer",
          "icon": "icons/view_icon.svg",
          "contextualTitle": "Entrypoint Explorer"
        },
        {
          "id": "menhir-lsp-derivation-view",
          "name": "Derivation Explorer",
          "icon": "icons/view_icon.svg",
          "contextualTitle": "Derivation Explorer"
        },
        {
          "id": "menhir-lsp-stack-view",
          "name": "Stack Explorer",
          "icon": "icons/view_icon.svg",
          "contextualTitle": "Stack Explorer"
        },
        {
          "id": "menhir-lr0-items-view",
          "name": "Lr0 Items Explorer",
          "icon": "icons/view_icon.svg",
          "contextualTitle": "Lr0 Items Explorer"
        },
        {
          "id": "menhir-lsp-action-map",
          "name": "Regexp-Token Mapping",
          "icon": "icons/view_icon.svg",
          "contextualTitle": "Regexp-Token Mapping"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "menhir-lsp-entrypoint-explorer",
        "contents": "The lexers and parsers you have opened will show up here ready for playing.\n\nNote: only the parsers that have been compiled to the [CMLY format](https://cambium.inria.fr/~fpottier/menhir/manual.html#sec110) will be shown. To obtain the CMLY representation for your parser add the --cmly flag inside the [menhir stanza](https://dune.readthedocs.io/en/stable/reference/dune/menhir.html) of its respective dune file."
      },
      {
        "view": "menhir-lsp-action-map",
        "contents": "This view will show a model of a lexer's semantics with respect to a grammar's token set once the interpreter is launched for two given lexer and parser entrypoints. The value bound to each pattern is used by the interpreter to drive the parser's automaton.\nThe initial mapping is inferred from the OCaml expressions of the rule and may be inaccurate; you can tweak it to best suit the lexer's semantics via the 🖉 icons so that each pattern has one of the following effects: (a) produce a token of the grammar; (b) skip the consumed text; (c) fail and halt the derivation."
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "menhir-lsp-view-container",
          "title": "Menhir LSP",
          "icon": "icons/view_icon.svg",
          "contextualTitle": "Menhir LSP"
        }
      ]
    },
    "commands": [
      {
        "title": "Menhir: Start Live Tokenizer",
        "command": "menhir-lsp-client.startTokenizer",
        "icon": "$(play)"
      },
      {
        "title": "Menhir: Go To Implementation",
        "shortTitle": "Go To Implementation",
        "command": "menhir-lsp-client.gotoImplementation",
        "icon": "$(open-preview)"
      },
      {
        "title": "Menhir: Show Language Server Output",
        "command": "menhir-lsp-client.showOutput"
      },
      {
        "title": "Menhir: Restart Language Server",
        "command": "menhir-lsp-client.restartServer"
      },
      {
        "title": "Menhir: Show AST View",
        "command": "menhir-lsp-client.astView"
      },
      {
        "title": "Menhir: Reveal AST Lode Under Cursor",
        "enablement": "never",
        "command": "menhir-lsp-client.revealAstNode"
      },
      {
        "title": "Menhir: Focus Next Message",
        "command": "menhir-lsp-client.nextMessage",
        "enablement": "editorLangId == ocaml.menhir.messages"
      },
      {
        "title": "Menhir: Focus Next Dummy Message",
        "command": "menhir-lsp-client.nextDummyMessage",
        "enablement": "editorLangId == ocaml.menhir.messages"
      },
      {
        "title": "Menhir: Focus Previous Message",
        "command": "menhir-lsp-client.previousMessage",
        "enablement": "editorLangId == ocaml.menhir.messages"
      },
      {
        "title": "Menhir: Focus Previous Dummy Message",
        "command": "menhir-lsp-client.previousDummyMessage",
        "enablement": "editorLangId == ocaml.menhir.messages"
      },
      {
        "title": "Menhir: Edit Regexp-Token Binding",
        "shortTitle": "Edit Binding",
        "command": "menhir-lsp-client.editRegexpTokenBinding",
        "icon": "$(edit)"
      },
      {
        "title": "Menhir: Refresh Entrypoints",
        "command": "menhir-lsp-client.refreshEntrypoints",
        "icon": "$(refresh)"
      },
      {
        "title": "Menhir: Step Forward",
        "enablement": "menhir-lsp-client.interpreterRunning == true",
        "command": "menhir-lsp-client.stepForward",
        "icon": "$(triangle-right)"
      },
      {
        "title": "Menhir: Step Back",
        "enablement": "menhir-lsp-client.interpreterRunning == true",
        "command": "menhir-lsp-client.stepBackward",
        "icon": "$(triangle-left)"
      },
      {
        "title": "Menhir: Play Forward",
        "enablement": "menhir-lsp-client.interpreterRunning == true",
        "command": "menhir-lsp-client.playForward",
        "icon": "$(debug-continue)"
      },
      {
        "title": "Menhir: Play Back",
        "enablement": "menhir-lsp-client.interpreterRunning == true",
        "command": "menhir-lsp-client.playBackward",
        "icon": "$(debug-reverse-continue)"
      },
      {
        "title": "Menhir: Jump to End",
        "enablement": "menhir-lsp-client.interpreterRunning == true",
        "command": "menhir-lsp-client.playToEnd",
        "icon": "$(play-to-end)"
      },
      {
        "title": "Menhir: Jump to Start",
        "enablement": "menhir-lsp-client.interpreterRunning == true",
        "command": "menhir-lsp-client.playToStart",
        "icon": "$(play-to-start)"
      },
      {
        "title": "Menhir: Start Interpreter on Token Sentence",
        "command": "menhir-lsp-client.startParser",
        "icon": "$(play)"
      },
      {
        "title": "Menhir: Start Interpreter on Text File",
        "enablement": "menhir-lsp-client.interpreterRunning == false",
        "command": "menhir-lsp-client.startParserWithCheckpoints",
        "icon": "$(debug-alt)"
      },
      {
        "title": "Menhir: Stop Interpreter",
        "enablement": "menhir-lsp-client.interpreterRunning == true",
        "command": "menhir-lsp-client.stopInterpreter",
        "icon": "$(debug-stop)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Menhir LSP - Formatting options",
      "properties": {
        "menhir.format.maxWidth": {
          "type": "integer",
          "default": 80,
          "description": "Maximum number of characters per line."
        },
        "menhir.format.indentOnce": {
          "type": "boolean",
          "default": false,
          "description": "Add a level of indentation to the cases of a rule or (default) keep them flush with the start of the definition."
        },
        "menhir.format.noLeadingBar": {
          "type": "boolean",
          "default": false,
          "description": "Omit the optional leading bar `|` in the first case of a rule."
        },
        "menhir.format.semiAfterProducer": {
          "type": "boolean",
          "default": false,
          "description": "Terminate every producer with a semicolon in Menhir rules written in the traditional syntax."
        }
      }
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "just bundle",
    "build": "just bundle",
    "debug": "just build",
    "watch": "just watch"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.73.0",
    "@types/vscode-webview": "^1.57.5",
    "esbuild": "^0.28.0",
    "esbuild-svelte": "^0.9.4",
    "mocha": "^11.7.5",
    "svelte": "^5.55.1",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}